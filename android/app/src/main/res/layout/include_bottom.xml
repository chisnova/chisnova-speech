<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@color/ds_surface"
    android:orientation="horizontal"
    android:weightSum="3"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="6dp">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/btnNavHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/iconNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home_24"
            android:layout_marginBottom="4dp"
            app:tint="@color/ds_nav_active" />

        <TextView
            android:id="@+id/textNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="홈"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ds_nav_active" />
    </LinearLayout>

    <!-- History -->
    <LinearLayout
        android:id="@+id/btnNavHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/iconNavHistory"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar_24"
            android:layout_marginBottom="4dp"
            app:tint="@color/ds_nav_inactive" />

        <TextView
            android:id="@+id/textNavHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="히스토리"
            android:textSize="11sp"
            android:textColor="@color/ds_nav_inactive" />
    </LinearLayout>

    <!-- Analysis -->
    <LinearLayout
        android:id="@+id/btnNavAnalysis"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/iconNavAnalysis"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bar_chart_24"
            android:layout_marginBottom="4dp"
            app:tint="@color/ds_nav_inactive" />

        <TextView
            android:id="@+id/textNavAnalysis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="분석"
            android:textSize="11sp"
            android:textColor="@color/ds_nav_inactive" />
    </LinearLayout>

</LinearLayout>
