<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ds_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:background="@color/ds_surface"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back_24"
            android:background="@drawable/bg_rounded_button"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="학습 히스토리"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Stats grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Average score -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="16dp"
                        android:layout_marginEnd="5dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_award_24"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ds_danger" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="평균 점수"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/averageScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82점"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Total attempts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="16dp"
                        android:layout_marginStart="5dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_trending_up_24"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ds_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="총 도전"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/totalAttempts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3회"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Total words -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="16dp"
                        android:layout_marginEnd="5dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_calendar_24"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ds_accent_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="학습 단어"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/totalWords"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6개"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Improvement needed -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card"
                        android:padding="16dp"
                        android:layout_marginStart="5dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_zap_24"
                                android:layout_marginEnd="6dp"
                                app:tint="@color/ds_warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="개선 필요"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/improvementNeeded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5개"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Filter buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="전체"
                    android:textSize="12sp"
                    android:background="@drawable/bg_filter_button_selected"
                    android:textColor="@color/text_on_primary"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <Button
                    android:id="@+id/btnFilterLevel1"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Level 1"
                    android:textSize="12sp"
                    android:background="@drawable/bg_filter_button"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <Button
                    android:id="@+id/btnFilterLevel2"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Level 2"
                    android:textSize="12sp"
                    android:background="@drawable/bg_filter_button"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:gravity="center"
                    android:includeFontPadding="false" />

                <Button
                    android:id="@+id/btnFilterLevel3"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Level 3"
                    android:textSize="12sp"
                    android:background="@drawable/bg_filter_button"
                    android:textColor="@color/text_secondary"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- History list container -->
            <LinearLayout
                android:id="@+id/historyListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="80dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav -->
    <include layout="@layout/include_bottom" />

</LinearLayout>
