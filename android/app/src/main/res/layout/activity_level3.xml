<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ds_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ds_surface"
        android:paddingHorizontal="16dp"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rounded_button"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="back"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연설문"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 3 · 명연설 발음 마스터"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Section title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="유명 연설문"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <!-- Speech item: Lincoln -->
            <LinearLayout
                android:id="@+id/speechLincoln"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_mic_24"
                    android:padding="18dp"
                    app:tint="@color/ds_accent_purple"
                    android:contentDescription="연설문"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abraham Lincoln's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="게티즈버그 연설 · 1863"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Mandela -->
            <LinearLayout
                android:id="@+id/speechMandela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_mic_24"
                    android:padding="18dp"
                    app:tint="@color/ds_accent_purple"
                    android:contentDescription="연설문"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nelson Mandela's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="대통령 취임 연설 · 1994"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Reagan -->
            <LinearLayout
                android:id="@+id/speechReagan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_mic_24"
                    android:padding="18dp"
                    app:tint="@color/ds_accent_purple"
                    android:contentDescription="연설문"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ronald Reagan's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="베를린 장벽 연설 · 발췌 · 1987"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Conan -->
            <LinearLayout
                android:id="@+id/speechConan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/conan"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conan O'Brien's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다트머스대 연설문"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Obama -->
            <LinearLayout
                android:id="@+id/speechObama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/obama"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barack Obama's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="취임 연설문"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: George Bush -->
            <LinearLayout
                android:id="@+id/speechBush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/bush"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="George Bush's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="911테러 추모 연설문"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: JFK -->
            <LinearLayout
                android:id="@+id/speechJFK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/jfk"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John F. Kennedy's Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="로버트프로스트 추모 연설문"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Martin Luther King Jr -->
            <LinearLayout
                android:id="@+id/speechKing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_list"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="1dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/king"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_rounded_16_stroke_20_white" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Martin Luther King Jr.'s Speech"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I have a dream"
                        android:textColor="@color/ds_accent_purple"
                        android:background="@color/ds_accent_purple_surface"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Speech item: Nelson Mandela -->
            

            <!-- Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_list"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연설문 학습 특징"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/ds_accent_purple"
                            android:background="@color/ds_accent_purple_surface"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="실제 명연설 학습"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="세계적으로 유명한 연설문으로 고급 영어 표현을 익혀보세요"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="@color/ds_accent_purple"
                            android:background="@color/ds_accent_purple_surface"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="감정과 뉘앙스 연습"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="연설자의 감정과 의도를 담은 발음 연습"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/ds_accent_purple"
                            android:background="@color/ds_accent_purple_surface"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="고급 어휘와 문법"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="격식있는 표현과 수사법을 자연스럽게 체득"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom" />

</LinearLayout>
