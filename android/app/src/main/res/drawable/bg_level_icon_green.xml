<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 학습 레벨 카드의 아이콘 배경. iOS HomeView 의 LevelCard 와 같은 모양이다 —
     둥근 사각형에 옅은 색을 깔고 아이콘 자체를 진한 색으로 칠한다. -->
