cmake_minimum_required(VERSION 3.16)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Platform build failed (${result}): ${ARGV}")
    endif()
endfunction()

if(platform MATCHES "^(arm64-v8a|armeabi-v7a)$")
    include("${CMAKE_CURRENT_LIST_DIR}/AndroidNdk.cmake")
    mercury_find_android_ndk(ndk "${ndk}")
    if(NOT EXISTS "${ndk}/build/cmake/android.toolchain.cmake")
        message(FATAL_ERROR "Set MERCURY_ANDROID_NDK or ANDROID_NDK_HOME to your Android NDK")
    endif()
    set(options "-DCMAKE_TOOLCHAIN_FILE=${ndk}/build/cmake/android.toolchain.cmake"
        "-DANDROID_ABI=${platform}" -DANDROID_PLATFORM=android-21)
elseif(platform MATCHES "^iphone")
    if(NOT CMAKE_HOST_APPLE)
        message(FATAL_ERROR "iOS export requires macOS and Xcode")
    endif()
    set(options -DCMAKE_SYSTEM_NAME=iOS "-DCMAKE_OSX_SYSROOT=${platform}"
        -DCMAKE_OSX_ARCHITECTURES=arm64 -DCMAKE_OSX_DEPLOYMENT_TARGET=16.0)
elseif(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Linux export requires a Linux host")
endif()
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G "${generator}"
    -DCMAKE_BUILD_TYPE=Release -DMERCURY_BUILD_TESTS=OFF "-DMERCURY_DIST_DIR=${dist}" ${options})
set(jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
if(NOT jobs)
    set(jobs 4)
endif()
run("${CMAKE_COMMAND}" --build "${build}" --config Release --target export_native --parallel "${jobs}")
