function(mercury_find_android_ndk output ndk)
    if(NOT ndk)
        set(ndk "$ENV{ANDROID_NDK_HOME}")
    endif()
    if(NOT ndk)
        file(GLOB candidates "$ENV{HOME}/Android/android-ndk-*" "$ENV{HOME}/Android/Sdk/ndk/*"
            "$ENV{HOME}/Library/Android/sdk/ndk/*")
        if(DEFINED ENV{ANDROID_HOME})
            file(GLOB sdk_ndks "$ENV{ANDROID_HOME}/ndk/*")
            list(APPEND candidates ${sdk_ndks})
        endif()
        foreach(candidate IN LISTS candidates)
            if(EXISTS "${candidate}/build/cmake/android.toolchain.cmake")
                set(ndk "${candidate}")
            endif()
        endforeach()
    endif()
    set(${output} "${ndk}" PARENT_SCOPE)
endfunction()
